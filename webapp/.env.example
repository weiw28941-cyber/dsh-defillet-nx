# Optional: explicitly opt in to reading a local OpenCode provider config.
# OPENCODE_CONFIG_PATH=C:/path/to/opencode.json
# DEFEATURE_PYTHON=C:/path/to/environment/python.exe

# Optional overrides. Do not commit real API keys.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=your-model
# OPENAI_AIMP_BIZ_ID=your-business-id
# OPENAI_AIGC_USER=your-user-id

# Set these to your licensed local NX installation.
# UGII_BASE_DIR=C:/Program Files/Siemens/NX2406
# NX_RUN_JOURNAL=C:/Program Files/Siemens/NX2406/NXBIN/run_journal.exe
# NX_STEP214_EXPORT_DEF=C:/Program Files/Siemens/NX2406/STEP214UG/ugstep214.def
STEP_WEB_MAX_UPLOAD_BYTES=104857600
STEP_WEB_NX_TIMEOUT_SECONDS=600
# Feed each failed NX attempt back to the planner; allowed range is 1-12.
STEP_WEB_MAX_DELETE_ATTEMPTS=6
STEP_WEB_MESH_DEFLECTION=0.25
STEP_WEB_MESH_ANGLE=0.5
